# CampusAI Environment Variables Configuration

# 1. Primary LLM: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Resilient Fallback LLM: Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# 3. Database
# Leave blank or use sqlite for local zero-dependency development:
DATABASE_URL=sqlite:///./campusai.db
# Or PostgreSQL for production deployment (Render / Railway):
# DATABASE_URL=postgresql://campusai_user:password@localhost:5432/campusai

# 4. Security & JWT
SECRET_KEY=campusai-production-grade-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
